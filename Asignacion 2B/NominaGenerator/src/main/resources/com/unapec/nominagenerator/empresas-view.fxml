<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unapec.nominagenerator.EmpresasController">
    <children>
        <Label fx:id="lbNombreTab" layoutX="16.0" layoutY="14.0" prefHeight="17.0" prefWidth="102.0" text="Sr. a " visible="false" />
        <Label fx:id="lbTabUsuarioDeseo" layoutX="108.0" layoutY="14.0" text="¿Qué desea hacer?" textFill="#ababab" visible="false">
            <font>
                <Font name="System Italic" size="12.0" />
            </font>
        </Label>

        <Separator layoutX="177.0" layoutY="59.0" prefHeight="15.0" prefWidth="580.0" />

        <Label fx:id="lbRNombreEmpresa" layoutX="14.0" layoutY="91.0" text="Nombre">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <TextField fx:id="txtNombreEmpresa" layoutX="87.0" layoutY="91.0" prefWidth="174.0" />

        <Label fx:id="lbNoDeCuenta" layoutX="273.0" layoutY="91.0" text="No. de Cuenta">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <TextField fx:id="txtNoCuenta" layoutX="383.0" layoutY="91.0" prefHeight="25.0" prefWidth="174.0" style="-fx-background-radius: 6;" />

        <Label fx:id="lbRNCEmpresa" layoutX="14.0" layoutY="131.0" text="RNC">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <TextField fx:id="txtRNC" layoutX="62.0" layoutY="131.0" prefHeight="25.0" prefWidth="174.0" style="-fx-background-radius: 6;" />

        <Label fx:id="lbFormaDePago" layoutX="273.0" layoutY="131.0" text="Forma de pago">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <ComboBox fx:id="cbFormaDePago" layoutX="389.0" layoutY="131.0" prefWidth="150.0" promptText="Forma de pago">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Semanal" />
                    <String fx:value="Quincenal" />
                    <String fx:value="Mensual" />
                </FXCollections>
            </items>
        </ComboBox>

        <Button fx:id="btnRegistrarCuenta" layoutX="427.0" layoutY="179.0" mnemonicParsing="false" onAction="#registrarEmpresa" text="Registrar Empresa" />

        <Separator layoutX="175.0" layoutY="209.0" prefHeight="15.0" prefWidth="580.0" />
        <Label layoutX="15.0" layoutY="204.0" text="Acceder a tu empresa">
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <Label fx:id="lbRNCconsultar" layoutX="16.0" layoutY="241.0" text="RNC">
            <font>
                <Font size="16.0" />
            </font>
        </Label>
        <TextField fx:id="txtConsultaRNC" layoutX="54.0" layoutY="241.0" prefHeight="25.0" prefWidth="138.0" style="-fx-background-radius: 10;" />
        <Button fx:id="btnConsultar" layoutX="207.0" layoutY="241.0" mnemonicParsing="false" onAction="#consultarEmpresa" text="Acceder" />

        <Label fx:id="lbNombreEmpresa" alignment="TOP_LEFT" layoutX="18.0" layoutY="285.0" prefHeight="45.0" prefWidth="260.0" text="Nombre:" visible="false" wrapText="true">
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <Label fx:id="lbCuentaBancaria" alignment="TOP_LEFT" layoutX="18.0" layoutY="330.0" prefHeight="30.0" prefWidth="260.0" text="Cuenta Bancaria:" visible="false" wrapText="true">
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <Label fx:id="lbFormaPago" alignment="TOP_LEFT" layoutX="18.0" layoutY="364.0" prefHeight="30.0" prefWidth="260.0" text="Forma de Pago:" visible="false" wrapText="true">
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <Label fx:id="lbCantidadEmpleados" alignment="TOP_LEFT" layoutX="18.0" layoutY="396.0" prefHeight="30.0" prefWidth="260.0" text="Cantidad de Empleados:" visible="false" wrapText="true">
            <font>
                <Font size="16.0" />
            </font>
        </Label>

        <TextArea fx:id="txtAreaDetalles" editable="false" layoutX="310.0" layoutY="245.0" prefHeight="350.0" prefWidth="450.0" style="-fx-font-family: 'Monospaced'; -fx-font-size: 13px;" wrapText="true" />

        <Label fx:id="lbErrorRegistro" layoutX="15.0" layoutY="280.0" prefWidth="350.0" visible="false" wrapText="true" />

        <Label fx:id="lbErrorConsulta" layoutX="400.0" layoutY="45.0" prefWidth="200.0" visible="false" wrapText="true" />

        <!-- Botón para limpiar campos -->
        <Button fx:id="btnLimpiarCampos" layoutX="600.0" layoutY="31.0" mnemonicParsing="false" onAction="#limpiarCampos" prefHeight="28.0" prefWidth="150.0" text="Limpiar Campos" />
      <Label layoutX="15.0" layoutY="54.0" text="Registra tu empresa">
         <font>
            <Font size="16.0" />
         </font>
      </Label>

    </children>
</AnchorPane>
